<main class="page">
    <section class="card">
        <h2>Login</h2>

        <p>Bitte melden Sie sich mit Ihrem Konto an.</p>

        {{#if flash}}
            <section class="flash-message">
                <p>{{flash}}</p>
            </section>
        {{/if}}

        <form class="form" action="/login" method="post">
            <fieldset>
                <label for="login">Login-Name:</label>
                <input type="text" id="login" name="login" placeholder="Login-Name" required>

                <label for="password">Passwort:</label>
                <input type="password" id="password" name="password" placeholder="Passwort eingeben" required>

                <button class="button" type="submit">Login</button>
            </fieldset>
        </form>

        <p>
            Haben Sie noch kein Konto?<br><br>
            <a class="button secondary" href="/register">Registrieren</a>
        </p>
    </section>
</main>