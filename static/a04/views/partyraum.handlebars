<main class="page">

    <section class="card">
        <h2>{{room.name}} reservieren</h2>

        <p>{{room.beschreibung}}</p>
        
        <form class="form" action="{{@root.base}}reservierungen/{{room.room_id}}/create" method="post">
            <fieldset>
                <label for="datum">Datum:</label>
                <input type="date" id="datum" name="datum" required>
            
                <label for="startzeit">Startzeit:</label>
                <input type="time" id="startzeit" name="startzeit" required>
            
                <label for="endzeit">Endzeit:</label>
                <input type="time" id="endzeit" name="endzeit" required>
            
                <button class="button" type="submit">Reservierung anfragen</button>
            </fieldset>
        </form>

        <section class="info-box">
            <h3>Meine Reservierungen</h3>

            {{#each reservations}}
                <section class="reservation-item">
                    <p>
                        <strong>{{datum}}</strong><br>
                        {{startzeit}} - {{endzeit}} Uhr
                    </p>

                    <p>
                        Reserviert von {{user_name}}
                    </p>

                    <p>
                        Status: {{status}}
                    </p>

                    <a class="button" href="{{@root.base}}reservierungen/{{reservation_id}}/edit">
                        Bearbeiten
                    </a>

                    <form action="{{@root.base}}reservierungen/{{reservation_id}}/delete" method="post">
                        <button class="button secondary" type="submit">Löschen</button>
                    </form>
                </section>
            {{/each}}
        </section>
    </section>

</main>