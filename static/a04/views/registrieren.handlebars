<main class="page">
    <section class="card">
        <h2>Registrieren</h2>

        <p>Erstellen Sie ein neues Konto für Wohnheim Portal.</p>

        <br>
        <form class="form" action="/dashboard" method="get">
        
            <label for="name">Name:</label>
            <input type="text" id="name" placeholder="Ihr Name">
            
            <label for="email">E-Mail-Adresse:</label>
            <input type="email" id="email" placeholder="name@example.com">
            
            <label for="zimmer">Zimmernummer:</label>
            <input type="text" id="zimmer" placeholder="z.B. 204">
            
            <label for="password">Passwort:</label>
            <input type="password" id="password" placeholder="Passwort eingeben">
            
            <label for="confirm-password">Passwort bestätigen:</label>
            <input type="password" id="confirm-password" placeholder="Passwort wiederholen">
            
            <button class ="button" type="submit">Konto erstellen</button>
        </form>


        <p>
            Haben Sie schon ein Konto?<br><br>
            <a class="button secondary" href="/login">Zurück zum Login</a>
        </p>
    </section>
</main>