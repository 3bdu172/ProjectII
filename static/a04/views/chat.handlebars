<main class="chat-page">
    <div class="chat-container">
        <h2>Wohnheim Chat</h2>

        <div class="chat-messages">
            <div class="message others-chat">
                <div class="message-sender">Max</div>
                <div class="message-text">When is the HM coming back?</div>
                <div class="message-timestamp">10:35</div>
            </div>

            <div class="message my-chat">
                <div class="message-sender">You</div>
                <div class="message-text">Next Monday</div>
                <div class="message-timestamp">11:05</div>
            </div>
        </div>

        <form class="chat-input-form">
            <input 
                type="text" 
                name="chat-input" 
                class="chat-input" 
                placeholder="Nachricht schreiben..."
            >

            <button type="submit" class="send-button">Senden</button>
        </form>
    </div>
</main>